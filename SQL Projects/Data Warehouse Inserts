-- =====================================================================
-- 04_load_all (v2 — aligned to warehouse schema v5)
-- Reloads dim_program, dim_client, bridge_client_source, fact_enrollment
-- in dependency order. Safe to re-run: every statement is idempotent.
--
-- v2 changes vs v1:
--   - dim_program: program_key removed from INSERT (IDENTITY in v5).
--   - fact_enrollment: assessment_date removed (dropped in v4/v5).
--   - fact_enrollment: orphan rows routed to stage_load_reject and not
--     loaded with NULL FKs. Facts never carry unresolved keys.
--   - bridge_client_source populated for every new SF/CIS client
--     (single-source cluster for now; cross-source matching is a
--     separate Silver step).
--   - All join keys normalized: UPPER + trim + collapse tabs/CR/LF.
--   - Added client_key / program_key NULL checks and reject-log checks.
--
-- NOTE: stg_sf_cis_client.county_name  →  dim_client.county
--
-- NOTE: This script joins dim_client on s.salesforce_id. If your
--       enrollment staging holds the client's SF ID in a different
--       column (e.g. client_salesforce_id) rather than reusing
--       salesforce_id, change the joins in section 5 accordingly.
--       The preflight in section 5b will surface the mismatch.
-- =====================================================================


-- ---------------------------------------------------------------------
-- 1. dim_program — insert new
-- ---------------------------------------------------------------------
INSERT INTO dim_program (program_name, source_system, load_datetime)
SELECT
    s.program_name,
    s.source_system,
    SYSDATETIME()
FROM (
    SELECT
        LTRIM(RTRIM(program_name))  AS program_name,
        LTRIM(RTRIM(source_system)) AS source_system,
        ROW_NUMBER() OVER (
            PARTITION BY LTRIM(RTRIM(program_name)),
                         LTRIM(RTRIM(source_system))
            ORDER BY program_name
        ) AS rn
    FROM stg_sf_cis_program
    WHERE program_name IS NOT NULL
      AND source_system IS NOT NULL
) s
WHERE s.rn = 1
  AND NOT EXISTS (
    SELECT 1 FROM dim_program d
    WHERE UPPER(REPLACE(REPLACE(REPLACE(LTRIM(RTRIM(d.program_name)),
             CHAR(9),' '), CHAR(10),' '), CHAR(13),' '))
        = UPPER(REPLACE(REPLACE(REPLACE(s.program_name,
             CHAR(9),' '), CHAR(10),' '), CHAR(13),' '))
      AND UPPER(LTRIM(RTRIM(d.source_system))) = UPPER(s.source_system)
);

-- If staging carries a stable program ID (salesforce_program_id),
-- add it to the column list above and use it as the business key
-- instead of program_name. Recommended once available.


-- ---------------------------------------------------------------------
-- 2. dim_client — insert new
--    New v5 crosswalk columns (hmis_client_id, champ_client_id,
--    ssn_hash, gender_identity, sexual_orientation) left NULL.
-- ---------------------------------------------------------------------
INSERT INTO dim_client (
    salesforce_id, salesforce_account_id, external_id,
    first_name, middle_name, last_name,
    date_of_birth, sex, gender, race, ethnicity,
    marital_status, number_of_children, education_level,
    email, home_phone, mobile_phone,
    address_line1, city, state, postal_code,
    county,
    veteran_status,
    military_branch, military_service_component, discharge_status,
    military_entry_date, military_discharge_date, is_post_9_11,
    service_connected, period_of_service,
    disability_status, mental_health_condition, substance_abuse,
    homeless_status, housing_status, length_of_homelessness, times_homeless_3yr,
    has_conviction, conviction_type, conviction_date,
    probation_parole_status, parole_end_date, last_release_date,
    experience_during_incarceration,
    service_type, lead_source,
    source_system, owner_id, created_by_id, created_date,
    last_modified_date, is_deleted, load_datetime
)
SELECT
    s.salesforce_id, s.salesforce_account_id, s.external_id,
    s.first_name, s.middle_name, s.last_name,
    s.date_of_birth, s.sex, s.gender, s.race, s.ethnicity,
    s.marital_status, s.number_of_children, s.education_level,
    s.email, s.home_phone, s.mobile_phone,
    s.address_line1, s.city, s.state, s.postal_code,
    s.county_name,
    s.veteran_status,
    s.military_branch, s.military_service_component, s.discharge_status,
    s.military_entry_date, s.military_discharge_date, s.is_post_9_11,
    s.service_connected, s.period_of_service,
    s.disability_status, s.mental_health_condition, s.substance_abuse,
    s.homeless_status, s.housing_status, s.length_of_homelessness, s.times_homeless_3yr,
    s.has_conviction, s.conviction_type, s.conviction_date,
    s.probation_parole_status, s.parole_end_date, s.last_release_date,
    s.experience_during_incarceration,
    s.service_type, s.lead_source,
    s.source_system, s.owner_id, s.created_by_id, s.created_date,
    s.last_modified_date, s.is_deleted,
    SYSDATETIME()
FROM (
    SELECT
        *,
        LTRIM(RTRIM(salesforce_id))  AS salesforce_id_clean,
        LTRIM(RTRIM(source_system))  AS source_system_clean,
        ROW_NUMBER() OVER (
            PARTITION BY LTRIM(RTRIM(salesforce_id)),
                         LTRIM(RTRIM(source_system))
            ORDER BY ISNULL(last_modified_date,'1900-01-01') DESC
        ) AS rn
    FROM stg_sf_cis_client
    WHERE salesforce_id IS NOT NULL
      AND source_system IS NOT NULL
) s
WHERE s.rn = 1
  AND NOT EXISTS (
    SELECT 1 FROM dim_client d
    WHERE UPPER(LTRIM(RTRIM(d.salesforce_id)))  = UPPER(s.salesforce_id_clean)
      AND UPPER(LTRIM(RTRIM(d.source_system)))  = UPPER(s.source_system_clean)
);


-- ---------------------------------------------------------------------
-- 3. dim_client — update existing
-- ---------------------------------------------------------------------
UPDATE d
