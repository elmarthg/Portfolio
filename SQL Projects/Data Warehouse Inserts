-- ---------------------------------------------------------------------
-- 12. Spot check — placements by program
-- ---------------------------------------------------------------------
SELECT
    ISNULL(p.program_name, '(no program)') AS program,
    COUNT(*) AS enrollments,
    SUM(CASE WHEN f.placement_date IS NOT NULL THEN 1 ELSE 0 END) AS placements
FROM fact_enrollment f
LEFT JOIN dim_program p ON p.program_key = f.program_key
GROUP BY p.program_name
ORDER BY enrollments DESC;
